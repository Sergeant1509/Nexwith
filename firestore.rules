rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'nexwith@gmail.com',
          'abhijeet.gautam1509@gmail.com',
          'paarijaat366@gmail.com'
        ];
    }

    match /applications/{applicationId} {
      // Public applicants may submit one document keyed by their normalized email.
      allow create: if applicationId == request.resource.data.email
        && request.resource.data.keys().hasOnly([
          'name','email','phone','city','education','role','availability',
          'about','resumeLink','links','createdAt'
        ]);

      // Only the three authorized administrators can read or manage applications.
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','reviewNotes','updatedAt'])
        && request.resource.data.status in ['pending','shortlisted','accepted','rejected'];
      allow delete: if isAdmin();
    }
  }
}